# Local consultation checkout. Use an existing Stripe account; never commit real keys.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_WEBHOOK_SECRET=
ZURTEX_LIVE_READY=false
ZURTEX_SITE_URL=http://localhost:3000
CONSULTATION_BOOKING_ENABLED=true

# Live source comparison. Hosted deployments use the existing Cloudflare AI binding.
# Keep keys server-side; never prefix these variables with NEXT_PUBLIC_.
ZURTEX_VERIFICATION_MODEL=@cf/ibm-granite/granite-4.0-h-micro
# Display source-linked research previews; this never grants human publication approval.
ZURTEX_RESEARCH_RESULTS_ENABLED=true
# Optional targeted web-index search; without this, discover links on official pages.
BRAVE_SEARCH_API_KEY=
# Optional REST connection when the Cloudflare Worker AI binding is unavailable.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
# Optional local open-weight model (requires a running compatible server):
# ZURTEX_VERIFICATION_PROVIDER=openai-compatible
# Tested local llama.cpp / Qwen3 4B configuration:
# ZURTEX_MODEL_BASE_URL=http://127.0.0.1:11435/v1
# ZURTEX_VERIFICATION_MODEL=zurtex-qwen3-4b
# Ollama alternative: http://127.0.0.1:11434/v1 with qwen3:4b-instruct
# ZURTEX_MODEL_API_KEY=
