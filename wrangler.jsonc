{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zurtex-site",
  "main": "vinext/server/fetch-handler",
  "workers_dev": true,
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "zurtex.org",
      "custom_domain": true
    },
    {
      "pattern": "www.zurtex.org",
      "custom_domain": true
    }
  ],
  "vars": {
    "STRIPE_MODE": "test",
    "ZURTEX_LIVE_READY": "false",
    "ZURTEX_SITE_URL": "https://zurtex.org",
    "FREE_ROUTE_GUIDE_ENABLED": "true",
    "PRIVATE_BETA_ENABLED": "true",
    "CONSULTATION_BOOKING_ENABLED": "true",
    "READY_PACK_WAITLIST_ENABLED": "true",
    "READY_PACK_SALES_ENABLED": "false",
    "MANUAL_REVIEW_ENABLED": "false",
    "DOCUMENT_UPLOADS_ENABLED": "false",
    "PAYMENT_CAPTURE_ENABLED": "false",
    "REFUNDABLE_RESERVATION_ENABLED": "false"
  }
}
